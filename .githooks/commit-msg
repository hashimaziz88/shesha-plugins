#!/usr/bin/env bash
# commit-msg is the ONLY hook git passes the message file to, which is why the
# format gate lives here rather than in pre-commit. At pre-commit time
# .git/COMMIT_EDITMSG still holds the PREVIOUS message, so a gate reading it there
# would validate the wrong text and pass.
set -euo pipefail

node packages/verify/src/gates/g-commit-format.mjs --message-file "$1"
