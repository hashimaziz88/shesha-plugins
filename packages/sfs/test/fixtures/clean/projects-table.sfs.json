{
  "sfs": "1.0",
  "form": "projects-table",
  "module": "boxfusion.test",
  "kind": "list",
  "entity": "boxfusion.test.Domain.Delivery.Project",
  "label": "Projects",
  "access": "authenticated",
  "brand": "shesha",
  "page": { "title": "Projects", "subtitle": "Active delivery engagements" },
  "body": [
    {
      "node": "data",
      "name": "projects",
      "pageSize": 10,
      "children": [
        {
          "node": "row",
          "name": "toolbar",
          "responsive": { "stack": "at:tablet", "fill": "searchCell", "fixed": { "addCell": "320px" }, "gap": 16 },
          "style": { "pad": { "top": 0, "bottom": 16 } },
          "children": [
            { "node": "col", "name": "searchCell", "children": [
              { "node": "search", "name": "quickSearch", "label": "Search projects" }
            ]},
            { "node": "col", "name": "addCell", "align": "end", "children": [
              { "node": "actions", "name": "tableActions", "label": "Table actions", "items": [
                {
                  "name": "btnAddProject", "label": "New project",
                  "style": "primary", "icon": "PlusOutlined",
                  "do": "openDialog",
                  "with": { "form": "boxfusion.test/project-create", "title": "New project", "width": "65%", "mode": "edit" },
                  "onSuccess": { "do": "refresh", "with": { "target": "projects" } }
                },
                {
                  "name": "btnArchiveProject", "label": "Archive",
                  "icon": "InboxOutlined",
                  "do": "openDialog",
                  "with": { "form": "boxfusion.test/project-archive", "title": "Archive projects" },
                  "onSuccess": { "do": "refresh", "with": { "target": "projects" } }
                }
              ]}
            ]}
          ]
        },
        {
          "node": "table",
          "name": "projectsTable",
          "label": "Projects",
          "freezeHeaders": true,
          "inline": "none",
          "style": { "surface": "card" },
          "onRowClick": { "do": "navigate", "with": { "form": "boxfusion.test/project-details", "args": { "id": "{{selectedRow.id}}" } } },
          "columns": [
            { "bind": "projectCode", "caption": "Code",       "width": 130, "min": 110, "sortable": true },
            { "bind": "projectName", "caption": "Project",                  "min": 200, "sortable": true },
            { "bind": "clientName",  "caption": "Client",     "width": 180, "min": 150 },
            { "bind": "startDate",   "caption": "Start",      "width": 140, "min": 120, "sortable": true },
            { "bind": "endDate",     "caption": "End",        "width": 140, "min": 120, "sortable": true },
            { "bind": "budget",      "caption": "Budget",     "width": 150, "min": 120 },
            { "bind": "status",      "caption": "Status",     "width": 150, "min": 130,
              "render": { "kind": "statusBadge", "refList": "boxfusion.test/ProjectStatus", "solid": true, "showName": true } }
          ]
        },
        { "node": "pager", "name": "projectsPager", "style": { "pad": { "top": 14 } } }
      ]
    }
  ]
}
