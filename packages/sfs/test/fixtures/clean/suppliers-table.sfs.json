{
  "sfs": "1.0",
  "form": "suppliers-table",
  "module": "boxfusion.test",
  "kind": "list",
  "entity": "boxfusion.test.Domain.Procurement.Supplier",
  "label": "Suppliers",
  "page": {
    "title": "Suppliers"
  },
  "body": [
    {
      "node": "data",
      "name": "suppliers",
      "children": [
        {
          "node": "row",
          "name": "toolbar",
          "responsive": {
            "stack": "at:tablet",
            "fill": "searchCell",
            "fixed": {
              "addCell": "190px"
            },
            "gap": 16
          },
          "children": [
            {
              "node": "col",
              "name": "searchCell",
              "children": [
                {
                  "node": "search",
                  "name": "quickSearch",
                  "label": "Search"
                }
              ]
            },
            {
              "node": "col",
              "name": "addCell",
              "align": "end",
              "children": [
                {
                  "node": "actions",
                  "name": "tableActions",
                  "label": "Table actions",
                  "items": [
                    {
                      "name": "btnAddSupplier",
                      "label": "Add supplier",
                      "style": "primary",
                      "icon": "PlusOutlined",
                      "do": "openDialog",
                      "with": {
                        "form": "boxfusion.test/supplier-create",
                        "title": "New supplier"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "node": "table",
          "name": "suppliersTable",
          "label": "Suppliers",
          "inline": "all",
          "onRowClick": {
            "do": "navigate",
            "with": {
              "form": "boxfusion.test/supplier-details",
              "args": {
                "id": "{{selectedRow.id}}"
              }
            }
          },
          "columns": [
            {
              "bind": "supplierCode",
              "caption": "Code",
              "width": 130,
              "min": 110,
              "sortable": true
            },
            {
              "bind": "supplierName",
              "caption": "Name",
              "min": 200,
              "sortable": true
            },
            {
              "bind": "category",
              "caption": "Category",
              "width": 160,
              "min": 140
            },
            {
              "bind": "contactEmail",
              "caption": "Email",
              "width": 220,
              "min": 180
            },
            {
              "bind": "phoneNumber",
              "caption": "Phone",
              "width": 160,
              "min": 130
            },
            {
              "bind": "country",
              "caption": "Country",
              "width": 150,
              "min": 120
            }
          ]
        },
        {
          "node": "pager",
          "name": "suppliersPager"
        }
      ]
    }
  ]
}
