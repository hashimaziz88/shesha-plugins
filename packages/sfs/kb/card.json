{
  "type": "card",
  "name": "Card",
  "isInput": false,
  "isOutput": null,
  "canBeJsSetting": null,
  "icon": "CodeSandboxSquareFilled",
  "version": 3,
  "initModel": {
    "defaults": {
      "stylingBox": "{\\\"marginBottom\\\":\\\"5\\\"}"
    },
    "raw": "(model) => ({\r\n    ...model,\r\n    header: { id: nanoid(), components: [] },\r\n    content: { id: nanoid(), components: [] },\r\n    stylingBox: \"{\\\"marginBottom\\\":\\\"5\\\"}\",\r\n  })"
  },
  "settingsProps": {
    "interfaceName": "ICardComponentProps",
    "interfaceFile": "designer-components/card/interfaces.ts",
    "ownProps": [
      "className",
      "content",
      "header",
      "hideHeading",
      "hideWhenEmpty",
      "border",
      "shadow",
      "background"
    ],
    "extends": [
      "IConfigurableFormComponent"
    ],
    "resolvedProps": [
      "_formFields",
      "allStyles",
      "autoHeight",
      "autoWidth",
      "background",
      "border",
      "className",
      "componentName",
      "content",
      "context",
      "customEnabled",
      "customVisibility",
      "description",
      "desktop",
      "dimensions",
      "editMode",
      "enableStyleOnReadonly",
      "font",
      "header",
      "hidden",
      "hideHeading",
      "hideLabel",
      "hideScrollBar",
      "hideWhenEmpty",
      "id",
      "initialContext",
      "injectedDefaultValue",
      "injectedTableRow",
      "inputStyles",
      "isDynamic",
      "jsSetting",
      "label",
      "labelAlign",
      "layout",
      "listType",
      "menuItemShadow",
      "mobile",
      "noDataIcon",
      "noDataSecondaryText",
      "noDataText",
      "onBlurCustom",
      "onChangeCustom",
      "onClickCustom",
      "onFocusCustom",
      "onSelectCustom",
      "overflow",
      "parentId",
      "permissions",
      "primaryBgColor",
      "primaryTextColor",
      "propertyName",
      "queryParams",
      "readOnly",
      "secondaryBgColor",
      "secondaryTextColor",
      "settingsValidationErrors",
      "shadow",
      "size",
      "style",
      "stylingBox",
      "subscribedEventNames",
      "tablet",
      "type",
      "validate",
      "wrapperStyle"
    ],
    "unresolvedExtends": [
      "IHasVersion"
    ]
  },
  "settingsForm": {
    "source": "card/settingsForm.ts",
    "mechanism": "fluent-builder",
    "parseQuality": "full"
  },
  "hasStandardAppearance": false,
  "appearanceFieldPaths": [
    "stylingBox",
    "style"
  ],
  "settingsFields": [
    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "Select a type of background"
    },
    {
      "path": "componentName",
      "label": "Component Name",
      "editorType": "settingsInput"
    },
    {
      "path": "label",
      "label": "Heading",
      "editorType": "settingsInput"
    },
    {
      "path": "hidden",
      "label": "Hide",
      "editorType": "settingsInput"
    },
    {
      "path": "hideHeading",
      "label": "Hide Heading",
      "editorType": "settingsInput"
    },
    {
      "path": "hideWhenEmpty",
      "label": "Hide When Empty",
      "editorType": "settingsInput"
    },
    {
      "path": "background.type",
      "label": "Type",
      "editorType": "settingsInput",
      "description": "Select a type of background",
      "group": "Background"
    },
    {
      "path": "background.color",
      "label": "Color",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.gradient.colors",
      "label": "Colors",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.url",
      "label": "URL",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.uploadFile",
      "label": "Image",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.storedFile.id",
      "label": "File ID",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.size",
      "label": "Size",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.repeat",
      "label": "Repeat",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "shadow.offsetX",
      "label": "Offset X",
      "editorType": "settingsInputRow",
      "group": "Shadow"
    },
    {
      "path": "stylingBox",
      "label": "Margin Padding",
      "editorType": "styleBox",
      "group": "Margin & Padding",
      "shared": true
    },
    {
      "path": "style",
      "label": "Style",
      "editorType": "settingsInput",
      "description": "A script that returns the style of the element as an object. This should conform to CSSProperties",
      "group": "Custom Styles",
      "shared": true
    },
    {
      "path": "className",
      "label": "Custom CSS Class",
      "editorType": "settingsInput",
      "group": "Custom Styles"
    },
    {
      "path": "permissions",
      "label": "Permissions",
      "editorType": "settingsInput"
    }
  ],
  "slots": {
    "hostsChildren": true,
    "customContainerNames": [
      "header",
      "content"
    ],
    "detectedSlotKeys": [
      "header",
      "content"
    ],
    "usesComponentsContainer": true
  },
  "sourceFiles": [
    "card/index.tsx",
    "card/interfaces.ts"
  ]
}
