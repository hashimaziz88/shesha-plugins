    },
    {
      "path": "showUserInfo",
      "label": "Show User Info",
      "editorType": "settingsInputRow"
    },
    {
      "path": "hidden",
      "label": "Hide",
      "editorType": "settingsInput"
    },
    {
      "path": "font",
      "label": "Family",
      "editorType": "settingsInputRow",
      "description": "Controls text thickness (light, normal, bold, etc.)",
      "group": "Font"
    },
    {
      "path": "subTextStyle",
      "label": "Custom Style",
      "editorType": "settingsInput",
