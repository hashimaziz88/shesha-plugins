{
  "type": "datatable.pager",
  "name": "Table Pager",
  "isInput": false,
  "isOutput": null,
  "canBeJsSetting": null,
  "icon": "ControlOutlined",
  "version": 4,
  "initModel": {
    "defaults": {
      "showSizeChanger": true,
      "showTotalItems": true
    },
    "raw": "(model: IPagerComponentProps) => {\r\n    return {\r\n      ...model,\r\n      showSizeChanger: true,\r\n      showTotalItems: true,\r\n      items: [],\r\n    };\r\n  }"
  },
  "settingsProps": {
    "interfaceName": "IPagerComponentProps",
    "interfaceFile": "designer-components/dataTable/pager/interfaces.ts",
    "ownProps": [],
    "extends": [
      "Omit<ITablePagerProps",
      "'style'>",
      "IConfigurableFormComponent"
    ],
    "resolvedProps": [
      "_formFields",
      "allStyles",
      "autoHeight",
      "autoWidth",
      "background",
      "border",
      "componentName",
      "context",
      "customEnabled",
      "customVisibility",
      "description",
      "desktop",
      "dimensions",
      "editMode",
      "enableStyleOnReadonly",
      "font",
      "hidden",
      "hideLabel",
      "hideScrollBar",
      "id",
      "initialContext",
      "injectedDefaultValue",
      "injectedTableRow",
      "inputStyles",
      "isDynamic",
      "jsSetting",
      "label",
      "labelAlign",
      "layout",
      "listType",
      "menuItemShadow",
      "mobile",
      "noDataIcon",
      "noDataSecondaryText",
      "noDataText",
      "onBlurCustom",
      "onChangeCustom",
      "onClickCustom",
      "onFocusCustom",
      "onSelectCustom",
      "overflow",
      "parentId",
      "permissions",
      "primaryBgColor",
      "primaryTextColor",
      "propertyName",
      "queryParams",
      "readOnly",
      "secondaryBgColor",
      "secondaryTextColor",
      "settingsValidationErrors",
      "shadow",
      "size",
      "style",
      "stylingBox",
      "subscribedEventNames",
      "tablet",
      "type",
      "validate",
      "wrapperStyle"
    ],
    "unresolvedExtends": [
      "'style'>",
      "IHasVersion",
      "Omit<ITablePagerProps"
    ]
  },
  "settingsForm": {
    "source": "dataTable/pager/settingsForm.ts",
    "mechanism": "fluent-builder",
    "parseQuality": "full"
  },
  "hasStandardAppearance": false,
  "appearanceFieldPaths": [
    "stylingBox",
    "style"
  ],
  "settingsFields": [
    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "Controls text thickness (light, normal, bold, etc.)"
    },
    {
      "path": "componentName",
      "label": "Component Name",
      "editorType": "settingsInputRow"
    },
    {
      "path": "showSizeChanger",
      "label": "Show Size Changer",
      "editorType": "settingsInputRow"
    },
    {
      "path": "hidden",
      "label": "Hide",
      "editorType": "settingsInput"
    },
    {
      "path": "font",
      "label": "Family",
      "editorType": "settingsInputRow",
      "description": "Controls text thickness (light, normal, bold, etc.)",
      "group": "Font"
    },
    {
      "path": "stylingBox",
      "label": "Margin Padding",
      "editorType": "styleBox",
      "group": "Margin & Padding",
      "shared": true
    },
    {
      "path": "style",
      "label": "Style",
      "editorType": "settingsInput",
      "description": "A script that returns the style of the element as an object. This should conform to CSSProperties",
      "group": "Custom Styles",
      "shared": true
    },
    {
      "path": "permissions",
      "label": "Permissions",
      "editorType": "settingsInput"
    }
  ],
  "slots": {
    "hostsChildren": false,
    "customContainerNames": null,
    "detectedSlotKeys": [],
    "usesComponentsContainer": false
  },
  "sourceFiles": [
    "dataTable/pager/pagerComponent.tsx",
    "dataTable/pager/interfaces.ts"
  ]
}
