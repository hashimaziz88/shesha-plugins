    },
    {
      "path": "isGroupingTimeSeries",
      "label": "Is Grouping Property Time Series?",
      "editorType": "settingsInputRow",
      "description": "If the grouping property is a time series, switch to true.",
      "group": "Quick Settings"
    },
    {
      "path": "showTitle",
      "label": "Show Title",
      "editorType": "settingsInputRow",
      "description": "Show the title of the chart",
      "group": "Labels"
    },
    {
      "path": "showLegend",
      "label": "Show Legend",
      "editorType": "settingsInputRow",
