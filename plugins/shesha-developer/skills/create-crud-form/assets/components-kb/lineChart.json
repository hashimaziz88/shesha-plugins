      "description": "If the pie chart is a doughnut chart, switch to true."
    },
    {
      "path": "dataMode",
      "label": "Data Source Type",
      "editorType": "settingsInputRow",
      "description": "The type of data source you want to use for the chart. If you select `URL`, you will have to provide a URL endpoint to the data. If you select `Entity Type`, you will have to select an entity type from the list.",
      "group": "Quick Settings"
    },
    {
      "path": "url",
      "label": "URL",
      "editorType": "settingsInput",
      "description": "The endpoint to use to fetch data.",
      "group": "Quick Settings"
    },
    {
      "path": "additionalProperties",
      "label": "Additional Properties",
      "editorType": "settingsInput",
      "description": "Additional properties you want to be passed when the form gets submitted like parentId in the case where the modal is used in a childTable. ",
      "group": "Quick Settings"
    },
    {
      "path": "entityType",
      "label": "Entity Type",
      "editorType": "settingsInputRow",
      "description": "The entity type you want to use.",
      "group": "Quick Settings"
    },
    {
      "path": "axisProperty",
      "label": "Axis Property",
      "editorType": "settingsInputRow",
      "description": "The property to be used on the x-axis.",
      "group": "Quick Settings"
    },
    {
