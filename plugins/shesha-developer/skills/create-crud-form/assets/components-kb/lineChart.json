      "group": "Labels"
    },
    {
      "path": "showYAxisScale",
      "label": "Show Y Axis",
      "editorType": "settingsInputRow",
      "group": "Labels"
    },
    {
      "path": "valuePropertyLabel",
      "label": "Value Property Label",
