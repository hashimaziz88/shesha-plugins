      "group": "Labels"
    },
    {
      "path": "showXAxisScale",
      "label": "Show X Axis",
      "editorType": "settingsInputRow",
      "group": "Labels"
    },
    {
      "path": "axisPropertyLabel",
      "label": "Axis Property Label",
      "editorType": "settingsInputRow",
