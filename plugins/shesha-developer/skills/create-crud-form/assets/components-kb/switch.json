{
  "type": "switch",
  "name": "Switch",
  "isInput": true,
  "isOutput": true,
  "canBeJsSetting": true,
  "icon": "SwitcherOutlined",
  "version": 6,
  "initModel": {
    "defaults": {
      "label": "Switch"
    },
    "raw": "(model) => {\r\n    return {\r\n      ...model,\r\n      label: 'Switch',\r\n    };\r\n  }"
  },
  "settingsProps": {
    "interfaceName": "ISwitchComponentProps",
    "interfaceFile": "designer-components/switch/interfaces.ts",
    "ownProps": [
      "value",
      "defaultChecked"
    ],
    "extends": [
      "IConfigurableFormComponent",
      "IStyleType"
    ],
    "resolvedProps": [
      "_formFields",
      "allStyles",
      "autoHeight",
      "autoWidth",
      "background",
      "border",
      "componentName",
      "context",
      "customEnabled",
      "customVisibility",
      "defaultChecked",
      "description",
      "desktop",
      "dimensions",
      "editMode",
      "enableStyleOnReadonly",
      "font",
      "hidden",
      "hideLabel",
      "hideScrollBar",
      "id",
      "initialContext",
      "injectedDefaultValue",
      "injectedTableRow",
      "inputStyles",
      "isDynamic",
      "jsSetting",
      "label",
      "labelAlign",
      "layout",
      "listType",
      "menuItemShadow",
      "mobile",
      "noDataIcon",
      "noDataSecondaryText",
      "noDataText",
      "onBlurCustom",
      "onChangeCustom",
      "onClickCustom",
      "onFocusCustom",
      "onSelectCustom",
      "overflow",
      "parentId",
      "permissions",
      "primaryBgColor",
      "primaryTextColor",
      "propertyName",
      "queryParams",
      "readOnly",
      "secondaryBgColor",
      "secondaryTextColor",
      "settingsValidationErrors",
      "shadow",
      "size",
      "style",
      "stylingBox",
      "subscribedEventNames",
      "tablet",
      "type",
      "validate",
      "value",
      "wrapperStyle"
    ],
    "unresolvedExtends": [
      "IHasVersion"
    ]
  },
  "settingsForm": {
    "source": "switch/settingsForm.ts",
    "mechanism": "fluent-builder",
    "parseQuality": "full"
  },
  "hasStandardAppearance": false,
  "appearanceFieldPaths": [
    "size",
    "style"
  ],
  "settingsFields": [
    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "Enter custom eventhandler on changing of event."
    },
    {
      "path": "propertyName",
      "label": "Property name",
      "editorType": "contextPropertyAutocomplete"
    },
    {
      "path": "hideLabel",
      "label": "Label",
      "editorType": "labelConfigurator"
    },
    {
      "path": "description",
      "label": "Tooltip",
      "editorType": "settingsInputRow"
    },
    {
      "path": "editMode",
      "label": "Edit Mode",
      "editorType": "settingsInputRow"
    },
    {
      "path": "onChangeCustom",
      "label": "On Change",
      "editorType": "settingsInput",
      "description": "Enter custom eventhandler on changing of event."
    },
    {
      "path": "enableStyleOnReadonly",
      "label": "Enable Style On Readonly",
      "editorType": "settingsInput",
      "description": "Removes all visual styling except typography when the component becomes read-only"
    },
    {
      "path": "size",
      "label": "Size",
      "editorType": "settingsInputRow",
      "group": "Dimensions",
      "shared": true
    },
    {
      "path": "style",
      "label": "Style",
      "editorType": "settingsInput",
      "description": "A script that returns the style of the element as an object. This should conform to CSSProperties",
      "group": "Custom Styles",
      "shared": true
    },
    {
      "path": "permissions",
      "label": "Permissions",
      "editorType": "settingsInput"
    }
  ],
  "slots": {
    "hostsChildren": false,
    "customContainerNames": null,
    "detectedSlotKeys": [],
    "usesComponentsContainer": false
  },
  "sourceFiles": [
    "switch/switch.tsx",
    "switch/interfaces.ts"
  ]
}
