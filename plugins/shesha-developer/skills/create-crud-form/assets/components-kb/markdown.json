{
  "type": "markdown",
  "name": "Markdown",
  "isInput": false,
  "isOutput": true,
  "canBeJsSetting": null,
  "icon": "EditOutlined",
  "version": 3,
  "initModel": {
    "defaults": null,
    "raw": "(model) => ({\r\n    ...model,\r\n    content: (model.content?.trim() ? model.content : `\r\n# Markdown Example\r\n\r\n## Basic Text\r\nThis is a paragraph with **bold text**, *italic text*, and ~~strikethrough text~~.\r\n\r\n## Lists\r\n- Bullet list item 1\r\n- Bullet list item 2\r\n\r\n1. Numbered list item 1\r\n2. Numbered list item 2\r\n\r\n## Links & Images\r\n[Shesha](https://www.shesha.io)  \r\n![Shesha Logo](https://raw.githubusercontent.com/shesha-io/shesha-framework/main/shesha-reactjs/public/images/app-logo.png)\r\n\r\n## Code\r\nInline code: \\`print(\"Hello, world!\")\\`\r\n\r\nBlock code:\r\n\\`\\`\\`python\r\ndef greet(name):\r\n  return f\"Hello, {name}!\"\r\n\r\ngreet(\"world\")\r\n\\`\\`\\``).trim(),\r\n  })"
  },
  "settingsProps": {
    "interfaceName": "IMarkdownProps",
    "interfaceFile": "designer-components/markdown/interfaces.ts",
    "ownProps": [
      "content",
      "textColor",
      "remarkPlugins",
      "style",
      "fontSize",
      "fontColor",
      "backgroundColor",
      "hideBorder",
      "borderSize",
      "borderRadius",
      "borderColor"
    ],
    "extends": [
      "IConfigurableFormComponent"
    ],
    "resolvedProps": [
      "_formFields",
      "allStyles",
      "autoHeight",
      "autoWidth",
      "background",
      "backgroundColor",
      "border",
      "borderColor",
      "borderRadius",
      "borderSize",
      "componentName",
      "content",
      "context",
      "customEnabled",
      "customVisibility",
      "description",
      "desktop",
      "dimensions",
      "editMode",
      "enableStyleOnReadonly",
      "font",
      "fontColor",
      "fontSize",
      "hidden",
      "hideBorder",
      "hideLabel",
      "hideScrollBar",
      "id",
      "initialContext",
      "injectedDefaultValue",
      "injectedTableRow",
      "inputStyles",
      "isDynamic",
      "jsSetting",
      "label",
      "labelAlign",
      "layout",
      "listType",
      "menuItemShadow",
      "mobile",
      "noDataIcon",
      "noDataSecondaryText",
      "noDataText",
      "onBlurCustom",
      "onChangeCustom",
      "onClickCustom",
      "onFocusCustom",
      "onSelectCustom",
      "overflow",
      "parentId",
      "permissions",
      "primaryBgColor",
      "primaryTextColor",
      "propertyName",
      "queryParams",
      "readOnly",
      "remarkPlugins",
      "secondaryBgColor",
      "secondaryTextColor",
      "settingsValidationErrors",
      "shadow",
      "size",
      "style",
      "stylingBox",
      "subscribedEventNames",
      "tablet",
      "textColor",
      "type",
      "validate",
      "wrapperStyle"
    ],
    "unresolvedExtends": [
      "IHasVersion"
    ]
  },
  "settingsForm": {
    "source": "markdown/settingsForm.json",
    "mechanism": "json-markup",
    "parseQuality": "full"
  },
  "hasStandardAppearance": false,
  "appearanceFieldPaths": [
    "style"
  ],
  "settingsFields": [
    {
      "path": "propertyName",
      "label": "Property name",
      "editorType": "contextPropertyAutocomplete",
      "group": "Display"
    },
    {
      "path": "content",
      "label": "Content",
      "editorType": "codeEditor",
      "group": "Display"
    },
    {
      "path": "hidden",
      "label": "Hidden",
      "editorType": "checkbox",
      "group": "Display"
    },
    {
      "path": "style",
      "label": "Style",
      "editorType": "codeEditor",
      "group": "Style",
      "description": "A script that returns the style of the element as an object. This should conform to CSSProperties",
      "shared": true
    },
    {
      "path": "permissions",
      "label": "Permissions",
      "editorType": "permissionAutocomplete",
      "group": "Security"
    }
  ],
  "slots": {
    "hostsChildren": false,
    "customContainerNames": null,
    "detectedSlotKeys": [
      "content"
    ],
    "usesComponentsContainer": false
  },
  "sourceFiles": [
    "markdown/index.tsx",
    "markdown/interfaces.ts"
  ]
}
