{
  "screen": "New Employee",
  "archetype": "standalone-capture",
  "theme": "requirements-studio",
  "viewport": "1440x900",
  "entity": {
    "fullClassName": "Boxfusion.HR.Domain.Employee",
    "modelType": { "name": "Employee", "module": "Boxfusion.HR" }
  },
  "form": { "module": "hr", "name": "employee-create", "label": "New Employee" },
  "nodes": [
    { "node": "page", "type": "container", "role": "page-root",
      "children": ["pageHeader", "validationErrors", "firstName", "lastName", "actionRow"] },
    { "node": "pageHeader", "type": "container", "role": "header-band", "slot": "page",
      "children": ["heading"] },
    { "node": "heading", "type": "text", "slot": "pageHeader", "content": "New Employee" },
    { "node": "validationErrors", "type": "validationErrors", "slot": "page" },
    { "node": "firstName", "type": "textField", "slot": "page", "content": "First Name" },
    { "node": "lastName", "type": "textField", "slot": "page", "content": "Last Name" },
    { "node": "actionRow", "type": "buttonGroup", "slot": "page",
      "items": [
        { "label": "Submit", "primary": true, "action": { "actionName": "Submit", "actionOwner": "shesha.form" } },
        { "label": "Back", "action": { "actionName": "Navigate", "actionOwner": "shesha.common" }, "target": "employee-table" }
      ] }
  ],
  "bindings": [
    { "label": "First Name", "property": "firstName", "component": "textField", "datatype": "string" },
    { "label": "Last Name", "property": "lastName", "component": "textField", "datatype": "string" }
  ],
  "assertions": [
    "parent-of(page, actionRow)"
  ],
  "dependencies": []
}
