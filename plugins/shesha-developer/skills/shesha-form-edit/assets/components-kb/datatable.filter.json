{
  "type": "datatable.filter",
  "name": "Table Filter",
  "isInput": false,
  "isOutput": null,
  "canBeJsSetting": null,
  "icon": "FilterOutlined",
  "version": 5,
  "initModel": {
    "defaults": {
      "buttonType": "link",
      "label": ""
    },
    "raw": "(model) => {\r\n    return {\r\n      ...model,\r\n      buttonType: 'link',\r\n      label: '',\r\n    };\r\n  }"
  },
  "settingsProps": {
    "interfaceName": "IAdvancedFilterButtonComponentProps",
    "interfaceFile": "designer-components/dataTable/advancedFilterButton/types.ts",
    "ownProps": [
      "buttonType"
    ],
    "extends": [
      "Omit<IButtonComponentProps",
      "'buttonType'>"
    ],
    "resolvedProps": [
      "buttonType"
    ],
    "unresolvedExtends": [
      "'buttonType'>",
      "Omit<IButtonComponentProps"
    ]
  },
  "settingsForm": {
    "source": "dataTable/advancedFilterButton/settingsForm.ts",
    "mechanism": "fluent-builder",
    "parseQuality": "full"
  },
  "hasStandardAppearance": false,
  "appearanceFieldPaths": [
    "stylingBox",
    "style"
  ],
  "settingsFields": [
    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "Controls text thickness (light, normal, bold, etc.)"
    },
    {
      "path": "componentName",
      "label": "Component name",
      "editorType": "settingsInput"
    },
    {
      "path": "label",
      "label": "Label",
      "editorType": "settingsInput"
    },
    {
      "path": "tooltip",
      "label": "Tooltip",
      "editorType": "settingsInput"
    },
    {
      "path": "icon",
      "label": "Icon",
      "editorType": "settingsInput"
    },
    {
      "path": "hidden",
      "label": "Hide",
      "editorType": "settingsInputRow"
    },
    {
      "path": "buttonType",
      "label": "Type",
      "editorType": "settingsInput"
    },
    {
      "path": "font",
      "label": "Family",
      "editorType": "settingsInputRow",
      "description": "Controls text thickness (light, normal, bold, etc.)",
      "group": "Font"
    },
    {
      "path": "dimensions.width",
      "label": "Width",
      "editorType": "settingsInputRow",
      "description": "You can use any unit (%, px, em, etc). px by default if without unit",
      "group": "Dimensions"
    },
    {
      "path": "dimensions.height",
      "label": "Height",
      "editorType": "settingsInputRow",
      "description": "You can use any unit (%, px, em, etc). px by default if without unit",
      "group": "Dimensions"
    },
    {
      "path": "background.type",
      "label": "Type",
      "editorType": "settingsInput",
      "description": "Select a type of background",
      "group": "Background"
    },
    {
      "path": "background.color",
      "label": "Color",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.gradient.colors",
      "label": "Colors",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.url",
      "label": "URL",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.uploadFile",
      "label": "Image",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.storedFile.id",
      "label": "File ID",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.size",
      "label": "Size",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.repeat",
      "label": "Repeat",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "shadow.offsetX",
      "label": "Offset X",
      "editorType": "settingsInputRow",
      "group": "Shadow"
    },
    {
      "path": "stylingBox",
      "label": "Margin Padding",
      "editorType": "styleBox",
      "group": "Margin & Padding",
      "shared": true
    },
    {
      "path": "style",
      "label": "Style",
      "editorType": "settingsInput",
      "description": "A script that returns the style of the element as an object. This should conform to CSSProperties",
      "group": "Custom Styles",
      "shared": true
    },
    {
      "path": "permissions",
      "label": "Permissions",
      "editorType": "settingsInput"
    }
  ],
  "slots": {
    "hostsChildren": false,
    "customContainerNames": null,
    "detectedSlotKeys": [],
    "usesComponentsContainer": false
  },
  "sourceFiles": [
    "dataTable/advancedFilterButton/advancedFilterButtonComponent.tsx",
    "dataTable/advancedFilterButton/types.ts"
  ]
}
