{
  "type": "tableViewSelector",
  "name": "Table View Selector",
  "isInput": false,
  "isOutput": null,
  "canBeJsSetting": null,
  "icon": "SelectOutlined",
  "version": 2,
  "initModel": {
    "defaults": null,
    "raw": "(model: ITableViewSelectorComponentProps) => {\r\n    // Ensure component always has at least 1 filter for WYSIWYG display\r\n    const defaultFilters = model.filters && model.filters.length > 0\r\n      ? model.filters\r\n      : [{\r\n        id: 'default-all-records',\r\n        name: 'Default',\r\n        tooltip: 'Shows all records without any filtering',\r\n        sortOrder: 0,\r\n        expression: null, // No filter expression = show all\r\n      }];\r\n\r\n    return {\r\n      ...model,\r\n      filters: defaultFilters,\r\n      persistSelectedFilters: model.persistSelectedFilters ?? true,\r\n    };\r\n  }"
  },
  "settingsProps": {
    "interfaceName": "ITableViewSelectorComponentProps",
    "interfaceFile": "designer-components/dataTable/tableViewSelector/models.ts",
    "ownProps": [
      "filters",
      "persistSelectedFilters",
      "showIcon"
    ],
    "extends": [
      "IConfigurableFormComponent"
    ],
    "resolvedProps": [
      "_formFields",
