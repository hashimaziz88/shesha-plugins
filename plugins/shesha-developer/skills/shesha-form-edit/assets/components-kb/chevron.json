{
  "type": "chevron",
  "name": "Chevron",
  "isInput": true,
  "isOutput": null,
  "canBeJsSetting": null,
  "icon": "FolderOpenOutlined",
  "version": 1,
  "initModel": null,
  "settingsProps": {
    "interfaceName": "IChevronProps",
    "interfaceFile": "components/chevron/models.ts",
    "ownProps": [
      "items",
      "description",
      "image",
      "imageStyle",
      "imageSize",
      "referenceList",
      "activeColor",
      "showIcons",
      "colorSource",
      "width",
      "height",
      "font"
    ],
    "extends": [
      "IConfigurableFormComponent"
    ],
    "resolvedProps": [
      "_formFields",
      "activeColor",
      "allStyles",
      "autoHeight",
      "autoWidth",
      "background",
      "border",
      "colorSource",
      "componentName",
      "context",
      "customEnabled",
      "customVisibility",
      "description",
      "desktop",
      "dimensions",
      "editMode",
      "enableStyleOnReadonly",
      "font",
      "height",
      "hidden",
      "hideLabel",
      "hideScrollBar",
      "id",
      "image",
      "imageSize",
      "imageStyle",
      "initialContext",
      "injectedDefaultValue",
      "injectedTableRow",
      "inputStyles",
      "isDynamic",
      "items",
      "jsSetting",
      "label",
      "labelAlign",
      "layout",
      "listType",
      "menuItemShadow",
      "mobile",
      "noDataIcon",
      "noDataSecondaryText",
      "noDataText",
      "onBlurCustom",
      "onChangeCustom",
      "onClickCustom",
      "onFocusCustom",
      "onSelectCustom",
      "overflow",
      "parentId",
      "permissions",
      "primaryBgColor",
      "primaryTextColor",
      "propertyName",
      "queryParams",
      "readOnly",
      "referenceList",
      "secondaryBgColor",
      "secondaryTextColor",
      "settingsValidationErrors",
      "shadow",
      "showIcons",
      "size",
      "style",
      "stylingBox",
      "subscribedEventNames",
      "tablet",
      "type",
      "validate",
      "width",
      "wrapperStyle"
    ],
    "unresolvedExtends": [
      "IHasVersion"
    ]
  },
  "settingsForm": {
    "source": "chevron/settingsForm.ts",
    "mechanism": "fluent-builder",
    "parseQuality": "full"
  },
  "appearanceFieldPaths": [
    "font",
    "font.type",
    "font.size",
    "font.weight",
    "font.color",
    "font.align",
    "stylingBox"
  ],
  "settingsFields": [
    {
      "path": "propertyName",
      "label": "Property Name",
      "editorType": "contextPropertyAutocomplete"
    },
    {
      "path": "hideLabel",
      "label": "Label",
      "editorType": "labelConfigurator"
    },
    {
      "path": "description",
      "label": "Tooltip",
      "editorType": "settingsInputRow"
    },
    {
      "path": "hidden",
      "label": "Hide",
      "editorType": "settingsInputRow"
    },
    {
      "path": "referenceList",
      "label": "Reference List",
      "editorType": "settingsInput",
      "description": "Make sure to reselect the reference list if any changes are made to its items"
    },
    {
      "path": "items",
      "label": "Items",
      "editorType": "RefListItemSelectorSettingsModal"
    },
    {
      "path": "font",
      "label": "Family",
      "editorType": "dropdown",
      "group": "Font"
    },
    {
      "path": "font.type",
      "label": "Size",
      "editorType": "numberField",
      "group": "Font"
    },
    {
      "path": "font.size",
      "label": "Weight",
      "editorType": "dropdown",
      "group": "Font"
    },
    {
      "path": "font.weight",
      "label": "Color",
      "editorType": "colorPicker",
      "description": "Controls text thickness (light, normal, bold, etc.)",
      "group": "Font"
    },
    {
      "path": "font.color",
      "label": "Align",
      "editorType": "dropdown",
      "group": "Font"
    },
    {
      "path": "font.align",
      "editorType": "settingsInputRow",
      "group": "Font"
    },
    {
      "path": "width",
      "label": "Height",
      "editorType": "textField",
      "description": "You can use any unit (%, px, em, etc). px by default if without unit",
      "group": "Dimensions"
    },
    {
      "path": "height",
      "editorType": "settingsInputRow",
      "description": "You can use any unit (%, px, em, etc). px by default if without unit",
      "group": "Dimensions"
    },
    {
      "path": "stylingBox",
      "editorType": "styleBox",
      "group": "Margin & Padding"
    },
    {
      "path": "colorSource",
      "label": "Color Source",
      "editorType": "dropdown",
      "description": "Hex and RGB colors are supported",
      "group": "Color Settings"
    },
    {
      "path": "activeColor",
      "label": "Active Color",
      "editorType": "colorPicker",
      "group": "Color Settings"
    },
    {
      "path": "showIcons",
      "label": "Show Icons",
      "editorType": "switch",
      "group": "Color Settings"
    },
    {
      "path": "permissions",
      "label": "Permissions",
      "editorType": "settingsInput",
      "description": "Enter a list of permissions that should be associated with this component"
    }
  ],
  "slots": {
    "hostsChildren": false,
    "customContainerNames": null,
    "detectedSlotKeys": [],
    "usesComponentsContainer": false
  },
  "sourceFiles": [
    "chevron/chevron.tsx",
    "../components/chevron/models.ts"
  ]
}
