{
  "type": "slider",
  "name": "Slider",
  "isInput": true,
  "isOutput": true,
  "canBeJsSetting": true,
  "icon": "SlidersFilled",
  "version": 1,
  "initModel": {
    "defaults": {
      "label": "Slider"
    },
    "raw": "(model) => {\r\n    return {\r\n      ...model,\r\n      label: 'Slider',\r\n    };\r\n  }"
  },
  "settingsProps": {
    "interfaceName": "ISliderComponentProps",
    "interfaceFile": "designer-components/slider/interfaces.ts",
    "ownProps": [
      "min",
      "max"
    ],
    "extends": [
      "IConfigurableFormComponent"
    ],
    "resolvedProps": [
      "_formFields",
      "allStyles",
      "autoHeight",
      "autoWidth",
      "background",
      "border",
      "componentName",
      "context",
      "customEnabled",
      "customVisibility",
      "description",
      "desktop",
      "dimensions",
      "editMode",
      "enableStyleOnReadonly",
      "font",
      "hidden",
      "hideLabel",
      "hideScrollBar",
      "id",
      "initialContext",
      "injectedDefaultValue",
      "injectedTableRow",
      "inputStyles",
      "isDynamic",
      "jsSetting",
      "label",
      "labelAlign",
      "layout",
      "listType",
      "max",
      "menuItemShadow",
      "min",
      "mobile",
      "noDataIcon",
      "noDataSecondaryText",
      "noDataText",
      "onBlurCustom",
      "onChangeCustom",
      "onClickCustom",
      "onFocusCustom",
      "onSelectCustom",
      "overflow",
      "parentId",
      "permissions",
      "primaryBgColor",
      "primaryTextColor",
      "propertyName",
      "queryParams",
      "readOnly",
      "secondaryBgColor",
      "secondaryTextColor",
      "settingsValidationErrors",
      "shadow",
      "size",
      "style",
      "stylingBox",
      "subscribedEventNames",
      "tablet",
      "type",
      "validate",
      "wrapperStyle"
    ],
    "unresolvedExtends": [
      "IHasVersion"
    ]
  },
  "settingsForm": {
    "source": "slider/settingsForm.ts",
    "mechanism": "fluent-builder",
    "parseQuality": "full"
  },
  "appearanceFieldPaths": [
    "style"
  ],
  "settingsFields": [
    {
      "path": "propertyName",
      "label": "Property name",
      "editorType": "contextPropertyAutocomplete"
    },
    {
      "path": "hideLabel",
      "label": "Label",
      "editorType": "labelConfigurator"
    },
    {
      "path": "editMode",
      "label": "Edit Mode",
      "editorType": "switch"
    },
    {
      "path": "hidden",
      "label": "Hide",
      "editorType": "settingsInputRow"
    },
    {
      "path": "min",
      "label": "Minimum",
      "editorType": "numberField"
    },
    {
      "path": "max",
      "label": "Maximum",
      "editorType": "settingsInputRow"
    },
    {
      "path": "enableStyleOnReadonly",
      "label": "Enable Style On Readonly",
      "editorType": "switch",
      "description": "Removes all visual styling except typography when the component becomes read-only"
    },
    {
      "path": "style",
      "label": "Style",
      "editorType": "settingsInput",
      "description": "A script that returns the style of the element as an object. This should conform to CSSProperties",
      "group": "Custom Styles"
    },
    {
      "path": "permissions",
      "label": "Permissions",
      "editorType": "settingsInput",
      "description": "Enter a list of permissions that should be associated with this component"
    }
  ],
  "slots": {
    "hostsChildren": false,
    "customContainerNames": null,
    "detectedSlotKeys": [],
    "usesComponentsContainer": false
  },
  "sourceFiles": [
    "slider/index.tsx",
    "slider/interfaces.ts"
  ]
}
