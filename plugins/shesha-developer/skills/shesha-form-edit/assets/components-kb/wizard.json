{
  "type": "wizard",
  "name": "Wizard",
  "isInput": false,
  "isOutput": null,
  "canBeJsSetting": null,
  "icon": "DoubleRightOutlined",
  "version": 8,
  "initModel": {
    "defaults": null,
    "raw": "(model) => ({\r\n    ...model,\r\n    steps: model.steps?.map((step) => ({\r\n      ...step,\r\n      showBackButton: step?.showBackButton ?? true,\r\n      showDoneButton: step?.showDoneButton ?? true,\r\n    })) ?? [],\r\n  })"
  },
