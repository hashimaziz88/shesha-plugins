    "interfaceName": "IWizardComponentProps",
    "interfaceFile": "designer-components/wizard/models.ts",
    "ownProps": [
      "steps",
      "wizardType",
      "form",
      "hidden",
      "customVisibility",
      "defaultActiveStep",
      "defaultActiveValue",
      "direction",
      "labelPlacement",
      "buttonsLayout",
      "showStepStatus",
      "sequence",
      "primaryTextColor",
      "primaryBgColor",
      "secondaryBgColor",
      "secondaryTextColor",
      "stepWidth"
    ],
    "extends": [
      "Omit<IConfigurableFormComponent",
      "'size'>",
      "Pick<StepProps",
      "'status'>",
      "Omit<IStyleType",
      "'size'>"
    ],
    "resolvedProps": [
      "buttonsLayout",
      "customVisibility",
      "defaultActiveStep",
      "defaultActiveValue",
      "direction",
      "form",
      "hidden",
      "labelPlacement",
