{
  "type": "wizard",
  "name": "Wizard",
  "isInput": false,
  "isOutput": null,
  "canBeJsSetting": null,
  "icon": "DoubleRightOutlined",
  "version": 8,
  "initModel": {
    "defaults": null,
    "raw": "(model) => ({\r\n    ...model,\r\n    steps: model.steps?.map((step) => ({\r\n      ...step,\r\n      showBackButton: step?.showBackButton ?? true,\r\n      showDoneButton: step?.showDoneButton ?? true,\r\n    })) ?? [],\r\n  })"
  },
  "settingsProps": {
    "interfaceName": "IWizardComponentProps",
    "interfaceFile": "designer-components/wizard/models.ts",
    "ownProps": [
      "steps",
      "wizardType",
      "form",
      "hidden",
      "customVisibility",
      "defaultActiveStep",
      "defaultActiveValue",
      "direction",
      "labelPlacement",
      "buttonsLayout",
      "showStepStatus",
      "sequence",
      "primaryTextColor",
      "primaryBgColor",
      "secondaryBgColor",
      "secondaryTextColor",
      "stepWidth"
    ],
    "extends": [
      "Omit<IConfigurableFormComponent",
      "'size'>",
      "Pick<StepProps",
      "'status'>",
      "Omit<IStyleType",
      "'size'>"
    ],
    "resolvedProps": [
      "buttonsLayout",
      "customVisibility",
      "defaultActiveStep",
      "defaultActiveValue",
      "direction",
      "form",
      "hidden",
      "labelPlacement",
      "primaryBgColor",
      "primaryTextColor",
      "secondaryBgColor",
      "secondaryTextColor",
      "sequence",
      "showStepStatus",
      "stepWidth",
      "steps",
      "wizardType"
    ],
    "unresolvedExtends": [
      "'size'>",
      "'status'>",
      "Omit<IConfigurableFormComponent",
      "Omit<IStyleType",
      "Pick<StepProps"
    ]
  },
  "settingsForm": {
    "source": "wizard/settingsForm.ts",
    "mechanism": "fluent-builder",
    "parseQuality": "full"
  },
  "hasStandardAppearance": false,
  "appearanceFieldPaths": [
    "stylingBox",
    "style"
  ],
  "settingsFields": [
    {
      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "To specify the direction of the step bar"
    },
    {
      "path": "componentName",
      "label": "Component Name",
      "editorType": "settingsInput"
    },
    {
      "path": "wizardType",
      "label": "Wizard Type",
      "editorType": "settingsInputRow",
      "description": "To specify the direction of the step bar"
    },
    {
      "path": "labelPlacement",
      "label": "Label Placement",
      "editorType": "settingsInputRow",
      "description": "To specify the label placement"
    },
    {
      "path": "steps",
      "label": "Configure Steps",
      "editorType": "settingsInputRow"
    },
    {
      "path": "font",
      "label": "Family",
      "editorType": "settingsInputRow",
      "description": "Controls text thickness (light, normal, bold, etc.)",
      "group": "Font"
    },
    {
      "path": "dimensions.width",
      "label": "Width",
      "editorType": "settingsInputRow",
      "description": "You can use any unit (%, px, em, etc). px by default if without unit",
      "group": "Dimensions"
    },
    {
      "path": "dimensions.height",
      "label": "Height",
      "editorType": "settingsInputRow",
      "description": "This is the height of the body of the wizard. You can use any unit (%, px, em, etc). px by default if without unit",
      "group": "Dimensions"
    },
    {
      "path": "background.type",
      "label": "Type",
      "editorType": "settingsInput",
      "description": "Select a type of background",
      "group": "Background"
    },
    {
      "path": "background.color",
      "label": "Color",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.gradient.colors",
      "label": "Colors",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.url",
      "label": "URL",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.uploadFile",
      "label": "Image",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.storedFile.id",
      "label": "File ID",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.size",
      "label": "Size",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "background.repeat",
      "label": "Repeat",
      "editorType": "settingsInputRow",
      "group": "Background"
    },
    {
      "path": "shadow.offsetX",
      "label": "Offset X",
      "editorType": "settingsInputRow",
      "description": "Offset X",
      "group": "Shadow"
    },
    {
      "path": "stylingBox",
      "label": "Margin Padding",
      "editorType": "styleBox",
      "group": "Margin & Padding",
      "shared": true
    },
    {
      "path": "style",
      "label": "Style",
      "editorType": "settingsInput",
      "description": "A script that returns the style of the element as an object. This should conform to CSSProperties",
      "group": "Custom Styles",
      "shared": true
    },
    {
      "path": "stepWidth",
      "label": "Step Width",
      "editorType": "settingsInputRow",
      "description": "You can use any unit (%, px, em, etc). px by default if without unit",
      "group": "Additional Styles"
    },
    {
      "path": "buttonsLayout",
      "label": "Buttons Layout",
      "editorType": "settingsInput",
      "description": "How you want the steps buttons to be aligned",
      "group": "Additional Styles"
    },
    {
      "path": "primaryBgColor",
      "label": "Primary Color",
      "editorType": "settingsInputRow",
      "group": "Additional Styles"
    },
    {
      "path": "secondaryBgColor",
      "label": "Secondary Color",
      "editorType": "settingsInputRow",
      "group": "Additional Styles"
    },
    {
      "path": "permissions",
      "label": "Permissions",
      "editorType": "settingsInput",
      "description": "Enter a list of permissions that should be associated with this component"
    }
  ],
  "slots": {
    "hostsChildren": true,
    "customContainerNames": [
      "steps"
    ],
    "detectedSlotKeys": [
      "components",
      "tabs",
      "steps"
    ],
    "usesComponentsContainer": true
  },
  "sourceFiles": [
    "wizard/index.tsx",
    "wizard/models.ts"
  ]
}
