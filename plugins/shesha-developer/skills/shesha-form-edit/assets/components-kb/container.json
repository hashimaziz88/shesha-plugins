      "path": "settingsTabs",
      "label": "Settings",
      "editorType": "searchableTabs",
      "description": "If checked, the default styles and classes of the container will not be applied."
    },
    {
      "path": "propertyName",
      "label": "Component Name",
      "editorType": "settingsInput"
    },
    {
      "path": "editMode",
      "label": "Edit Mode",
      "editorType": "settingsInputRow"
    },
    {
      "path": "noDefaultStyling",
      "label": "No Default Styling",
      "editorType": "settingsInput",
      "description": "If checked, the default styles and classes of the container will not be applied."
    },
    {
      "path": "position.value",
      "label": "Position",
      "editorType": "settingsInput",
      "description": "The position CSS property sets how an element is positioned in a document. The top, right, bottom, and left properties determine the final location of positioned elements.",
      "group": "Position"
    },
    {
      "path": "pnlDisplayStyle",
      "label": "Display",
      "editorType": "settingsInputRow",
      "description": "The display CSS property sets whether an element is treated as a block or inline element and the layout used for its children, such as flow layout, grid or flex.",
      "group": "Position"
    },
    {
      "path": "display",
      "label": "Layout Type",
      "editorType": "settingsInput",
      "description": "The display CSS property sets whether an element is treated as a block or inline element and the layout used for its children, such as flow layout, grid or flex.",
      "group": "Display"
    },
    {
      "path": "flexDirection",
      "label": "Flex Direction",
      "editorType": "settingsInputRow",
      "description": "Show advanced settings",
      "group": "Display"
    },
    {
      "path": "gap",
      "label": "Gap",
      "editorType": "settingsInputRow",
      "description": "Examples of a valid gap include: `10` | `10px` | `20px 20px`",
      "group": "Display"
    },
    {
      "path": "justifyContent",
      "label": "Justify Content",
      "editorType": "settingsInputRow",
      "group": "Display"
    },
    {
      "path": "alignSelf",
      "label": "Align Self",
      "editorType": "settingsInputRow",
      "description": "The align-self CSS property overrides a grid or flex item's align-items value. In Grid, it aligns the item inside the grid area. In Flexbox, it aligns the item on the cross axis.",
      "group": "Display"
    },
    {
      "path": "justifySelf",
      "label": "Justify Self",
      "editorType": "settingsInput",
      "description": "The CSS justify-self property sets the way a box is justified inside its alignment container along the appropriate axis.",
      "group": "Display"
    },
    {
      "path": "dimensions.width",
      "label": "Width",
      "editorType": "settingsInputRow",
      "description": "You can use any unit (%, px, em, etc). px by default if without unit",
      "group": "Dimensions"
    },
    {
      "path": "dimensions.height",
      "label": "Height",
      "editorType": "settingsInputRow",
      "description": "You can use any unit (%, px, em, etc). px by default if without unit",
      "group": "Dimensions"
    },
    {
      "path": "background.type",
