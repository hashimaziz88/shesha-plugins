{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shesha-form-config.schema.json",
  "title": "Shesha form configuration markup (0.45)",
  "description": "Generated from components-kb (releases/0.45@3418e292f, 115 component types). A component type not in the enum is unusable by definition (L0/L1).",
  "type": "object",
  "required": [
    "components",
    "formSettings"
  ],
  "properties": {
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "formSettings": {
      "type": "object",
      "properties": {
        "layout": {
          "enum": [
            "horizontal",
            "vertical",
            "inline"
          ]
        },
        "modelType": {
          "description": "0.45: the {name, module} object resolved from live EntityConfig [R-016]",
          "type": [
            "object",
            "string"
          ]
        },
        "labelCol": {
          "type": "object"
        },
        "wrapperCol": {
          "type": "object"
        },
        "access": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "component": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "uuid or nanoid — short placeholder ids are silently ignored [R-002]",
          "pattern": "^(?:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[A-Za-z0-9_-]{10,})$"
        },
        "type": {
          "enum": [
            "KeyInformationBar",
            "address",
            "alert",
            "attachmentsEditor",
            "autocomplete",
            "autocompleteTagGroup",
            "barChart",
            "button",
            "buttonGroup",
            "buttons",
            "calendar",
            "card",
            "checkbox",
            "checkboxGroup",
            "chevron",
            "childTable",
            "codeEditor",
            "collapsiblePanel",
            "colorPicker",
            "columns",
            "columnsEditorComponent",
            "component-selector",
            "configurableActionConfigurator",
            "configurableItemAutocomplete",
            "container",
            "contextPropertyAutocomplete",
            "dataContext",
            "dataContextSelector",
            "dataSortingEditor",
            "dataSource",
            "datalist",
            "datatable",
            "datatable.filter",
            "datatable.pager",
            "datatable.quickSearch",
            "datatable.selectColumnsButton",
            "datatableContext",
            "dateField",
            "divider",
            "drawer",
            "dropdown",
            "dynamicItemsConfigurator",
            "dynamicView",
            "editModeSelector",
            "editableTagGroup",
            "endpointsAutocomplete",
            "entityPicker",
            "entityReference",
            "entityTypeAutocomplete",
            "fileUpload",
            "formAutocomplete",
            "htmlRender",
            "iconPicker",
            "image",
            "imagePicker",
            "kanban",
            "labelConfigurator",
            "labelValueEditor",
            "lineChart",
            "link",
            "list",
            "logViewer",
            "mainMenuEditor",
            "markdown",
            "menuList",
            "metadataEditor",
            "notes",
            "notificationAutocomplete",
            "numberField",
            "paragraph",
            "passwordCombo",
            "permissionAutocomplete",
            "permissionTagGroup",
            "permissionedObjectsTree",
            "permissionsTree",
            "pieChart",
            "polarAreaChart",
            "processMonitor",
            "profileDropdown",
            "progress",
            "propertyAutocomplete",
            "propertyRouter",
            "queryBuilder",
            "radio",
            "rate",
            "refListStatus",
            "referenceListAutocomplete",
            "richTextEditor",
            "scheduledJobExecutionLog",
            "searchableTabs",
            "section",
            "sectionSeparator",
            "setting",
            "settingsInput",
            "settingsInputRow",
            "sizableColumns",
            "slider",
            "space",
            "statistic",
            "statusTag",
            "styleBox",
            "subForm",
            "switch",
            "tableViewSelector",
            "tabs",
            "text",
            "textArea",
            "textField",
            "themeEditor",
            "threeStateSwitch",
            "timePicker",
            "title",
            "toolbar",
            "validationErrors",
            "wizard"
          ]
        },
        "version": {
          "type": "integer",
          "description": "current KB version per type [R-003]"
        },
        "parentId": {
          "type": "string",
          "description": "direct parent id; root components use \"root\" [R-001]"
        },
        "propertyName": {
          "type": "string",
          "pattern": "^[a-z]",
          "description": "camelCase [R-004]"
        },
        "defaultValue": {
          "type": "string",
          "description": "mustache-template STRING only [R-009]"
        },
        "customVisibility": {
          "not": {},
          "description": "IGNORED on 0.45 — use code-mode hidden [R-031]"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        }
      },
      "additionalProperties": true
    }
  },
