{
  "screen": "Asset hub",
  "subtitle": "Register  /  Assets  /  Hub",
  "entity": {
    "fullClassName": "boxfusion.test.Domain.Domain.Assets.Asset",
    "modelType": { "name": "Asset", "module": "boxfusion.test" }
  },
  "form": { "module": "boxfusion.test", "name": "gym-asset-hub", "label": "Asset" },
  "archetype": "hub",
  "theme": "shesha",
  "layout": {
    "kind": "stack", "gap": "lg", "padding": "lg",
    "children": [
      { "kind": "heading", "level": 1, "content": "Asset hub" },
      { "kind": "row", "name": "hubSplit", "gap": "lg", "align": "stretch", "children": [
        { "kind": "container", "name": "mainCol", "width": "66%", "gap": "lg", "children": [
          { "kind": "card", "title": "Maintenance history", "padding": "md", "gap": "md", "children": [
            { "kind": "datatable", "name": "maintenanceLog", "columns": ["name", "location", "purchaseDate"] }
          ] }
        ] },
        { "kind": "container", "name": "railCol", "width": "33%", "gap": "lg", "children": [
          { "kind": "card", "title": "Related assets", "padding": "md", "gap": "md", "children": [
            { "kind": "datalist", "name": "relatedAssets", "itemForm": "gym-asset-card" }
          ] }
        ] }
      ] }
    ]
  },
  "bindings": [
    { "label": "Asset Name", "property": "name" },
    { "label": "Serial Number", "property": "serialNumber" },
    { "label": "Location", "property": "location" },
    {
      "property": "status",
      "datatype": "reference-list-item",
      "referenceList": { "module": "boxfusion.test", "name": "AssetStatus" }
    }
  ],
  "assertions": [
    {"id":"A1","kind":"exists","subject":"pageHeaderBand","description":"the page opens with a header band carrying the screen title, the subtitle trail and a status chip"},
    {"id":"A2","kind":"order","subject":"pageHeaderBand","target":"hubSplit","description":"the band, then the meta strip, then the split — a KeyInformationBar meta strip sits under the band"},
    {"id":"A3","kind":"child-count","subject":"hubSplit","count":2,"description":"hubSplit has exactly two children"},
    {"id":"A4","kind":"order","subject":"mainCol","target":"railCol","description":"mainCol left of railCol"},
    {"id":"A5","kind":"relative-width","subject":"mainCol","ratio":0.66,"description":"mainCol takes two thirds of the split"},
    {"id":"A6","kind":"relative-width","subject":"railCol","ratio":0.33,"description":"railCol takes one third of the split"},
    {"id":"A7","kind":"contains","subject":"mainCol","target":"maintenanceLog","description":"the main column holds one data region"},
    {"id":"A8","kind":"contains","subject":"railCol","target":"relatedAssets","description":"the rail holds one data region"}
  ]
}
