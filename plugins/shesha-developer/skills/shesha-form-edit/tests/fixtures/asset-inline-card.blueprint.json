{
  "screen": "Asset inline card",
  "entity": {
    "fullClassName": "boxfusion.test.Domain.Domain.Assets.Asset",
    "modelType": { "name": "Asset", "module": "boxfusion.test" }
  },
  "form": { "module": "boxfusion.test", "name": "gym-asset-inline-card", "label": "Asset" },
  "archetype": "inline-card",
  "theme": "shesha",
  "layout": {
    "kind": "stack", "name": "cardHost", "gap": "md", "padding": "md",
    "children": [
      { "kind": "card", "name": "assetInlineCard", "padding": "md", "gap": "sm", "children": [
        { "kind": "row", "name": "cardTopRow", "gap": "md", "justify": "space-between", "align": "center", "children": [
          { "kind": "heading", "level": 3, "name": "cardTitle", "content": "{{data.name}}" },
          { "kind": "field", "property": "status" }
        ] },
        { "kind": "grid", "columns": 2, "gap": "sm", "children": [
          { "kind": "field", "property": "serialNumber" },
          { "kind": "field", "property": "location" }
        ] }
      ] }
    ]
  },
  "bindings": [
    { "label": "Serial Number", "property": "serialNumber" },
    { "label": "Location", "property": "location" },
    {
      "property": "status",
      "datatype": "reference-list-item",
      "referenceList": { "module": "boxfusion.test", "name": "AssetStatus" }
    }
  ],
  "assertions": [
    {"id":"A1","kind":"exists","subject":"assetInlineCard","description":"the whole screen is ONE card"},
    {"id":"A2","kind":"contains","subject":"assetInlineCard","target":"cardTopRow","description":"the card opens with its title row"},
    {"id":"A3","kind":"same-row","subject":"cardTitle","target":"status","description":"title and status on one line"},
    {"id":"A4","kind":"visible","subject":"status","description":"the status property renders as a reference-list editor, never as plain text [R-036]"}
  ]
}
