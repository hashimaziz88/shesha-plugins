{
  "screen": "Asset worklist",
  "entity": {
    "fullClassName": "boxfusion.test.Domain.Domain.Assets.Asset",
    "modelType": { "name": "Asset", "module": "boxfusion.test" }
  },
  "form": { "module": "boxfusion.test", "name": "gym-asset-worklist", "label": "Assets" },
  "archetype": "table-worklist",
  "theme": "shesha",
  "layout": {
    "kind": "stack", "gap": "lg", "padding": "lg",
    "children": [
      { "kind": "heading", "level": 1, "content": "Assets" },
      { "kind": "row", "name": "toolbar", "gap": "md", "justify": "space-between", "align": "center", "children": [
        { "kind": "text", "name": "toolbarHint", "content": "Every asset on the register, newest first." },
        { "kind": "actions" }
      ] },
      {
        "kind": "datatable",
        "name": "assets",
        "columns": ["name", "serialNumber", "category", "location", "status", "purchaseDate"],
        "rowAction": { "kind": "open-record" }
      }
    ]
  },
  "bindings": [
    { "property": "status", "label": "Status", "referenceList": { "module": "boxfusion.test", "name": "AssetStatus" } }
  ],
  "assertions": [
    {"id":"A1","kind":"exists","subject":"assets","description":"the table is wrapped in a dataContext carrying entityType + sourceType Entity [R-005]"},
    {"id":"A2","kind":"same-row","subject":"toolbarHint","target":"formActions","description":"toolbar hint and action row sit on one line"},
    {"id":"A3","kind":"alignment","subject":"toolbar","target":"space-between","description":"the toolbar spreads its hint and its actions apart"}
  ]
}
