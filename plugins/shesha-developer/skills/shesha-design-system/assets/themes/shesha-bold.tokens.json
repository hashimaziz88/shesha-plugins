        "hoverBorderColor": "#0047FF",
        "activeBorderColor": "#0047FF",
        "activeShadow": "0 0 0 4px rgba(0,71,255,0.24)",
        "errorActiveShadow": "0 0 0 4px rgba(214,17,17,0.15)"
      },
      "Select": {
        "borderRadius": 6,
