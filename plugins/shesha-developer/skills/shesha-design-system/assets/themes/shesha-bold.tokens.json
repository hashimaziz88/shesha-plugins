    "token": {
      "colorPrimary": "#0047FF",
      "colorPrimaryHover": "#0039D6",
      "colorPrimaryActive": "#002EB0",
      "colorPrimaryBg": "#E0E9FF",
      "colorPrimaryBgHover": "#D2DEFF",
      "colorPrimaryBorder": "#8FAAFF",
      "colorPrimaryBorderHover": "#5C82FF",
      "colorPrimaryText": "#0047FF",
      "colorPrimaryTextHover": "#0039D6",
      "colorSuccess": "#007E00",
      "colorSuccessBg": "#E8F5E9",
      "colorSuccessBorder": "#23B414",
      "colorWarning": "#FF6600",
      "colorWarningBg": "#FFF8E1",
      "colorWarningBorder": "#FEBA00",
      "colorError": "#D61111",
      "colorErrorBg": "#FFEBEE",
      "colorErrorBorder": "#D61111",
      "colorInfo": "#0047FF",
      "colorInfoBg": "#E0E9FF",
      "colorInfoBorder": "#0047FF",
      "colorTextBase": "#181818",
      "colorText": "#181818",
      "colorTextSecondary": "#333333",
      "colorTextTertiary": "#9BA3B8",
      "colorTextQuaternary": "#C0C5D0",
      "colorBgBase": "#FFFFFF",
      "colorBgContainer": "#FFFFFF",
      "colorBgLayout": "#F8F8F9",
      "colorBgElevated": "#FFFFFF",
      "colorBgSpotlight": "#0047FF",
      "colorBorder": "#D0D5E0",
      "colorBorderSecondary": "#E8EAF0",
      "colorFill": "#F0F2F5",
      "colorFillSecondary": "#F8F8F9",
      "colorFillTertiary": "#FAFBFC",
      "colorFillQuaternary": "#FFFFFF",
      "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Noto Sans\", Helvetica, Arial, sans-serif",
      "fontFamilyCode": "ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, monospace",
      "fontSize": 14,
      "fontSizeSM": 12,
      "fontSizeLG": 16,
      "fontSizeXL": 20,
      "fontSizeHeading1": 24,
      "fontSizeHeading2": 20,
      "fontSizeHeading3": 16,
      "fontSizeHeading4": 14,
      "fontWeightStrong": 600,
      "lineHeight": 1.571,
      "lineHeightSM": 1.5,
      "lineHeightLG": 1.5,
      "lineHeightHeading1": 1.25,
      "lineHeightHeading2": 1.3,
      "lineHeightHeading3": 1.375,
      "borderRadius": 6,
      "borderRadiusSM": 4,
      "borderRadiusLG": 8,
      "borderRadiusXS": 2,
      "controlHeight": 32,
      "controlHeightSM": 24,
      "controlHeightLG": 40,
      "padding": 16,
      "paddingSM": 12,
      "paddingXS": 8,
