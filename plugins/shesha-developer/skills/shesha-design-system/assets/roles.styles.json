      "stylingBox": { "padding": "$spacing.2" }
    },
    "tablet": { "$inherit": "desktop", "flexWrap": "wrap" },
    "mobile": {
      "$inherit": "desktop",
      "flexDirection": "column", "alignItems": "stretch", "flexWrap": "wrap",
      "stylingBox": { "padding": "$spacing.3" }
    }
  },

