      "shadow": { "offsetX": 0, "offsetY": 0, "blurRadius": 0, "spreadRadius": 0, "color": "transparent" },
      "stylingBox": { "padding": "$spacing.2" }
    },
    "tablet": { "$inherit": "desktop" },
    "mobile": {
      "$inherit": "desktop",
      "justifyContent": "center", "flexWrap": "wrap"
    }
  },

