{
  "page-root": {
    "componentType": "container",
    "desktop": {
      "display": "flex", "flexDirection": "column", "flexWrap": "nowrap",
      "gap": "$spacing.6", "justifyContent": "flex-start", "alignItems": "stretch",
      "dimensions": {
        "width": "100%", "minWidth": "0", "maxWidth": "none",
        "height": "auto", "minHeight": "fit-content", "maxHeight": "none"
      },
      "background": { "type": "color", "color": "$roles.pageBg" },
      "border": {
        "borderType": "none", "radiusType": "all",
        "radius": { "all": "$radius.xs" },
        "border": { "all": { "color": "transparent", "style": "none", "width": "0px" } }
      },
      "shadow": { "offsetX": 0, "offsetY": 0, "blurRadius": 0, "spreadRadius": 0, "color": "transparent" },
      "stylingBox": { "padding": "$spacing.6" }
    },
    "tablet": { "$inherit": "desktop", "stylingBox": { "padding": "$spacing.4" } },
    "mobile": { "$inherit": "desktop", "stylingBox": { "padding": "$spacing.3" } }
  },

  "dialog-root": {
    "componentType": "container",
    "desktop": {
      "display": "flex", "flexDirection": "column", "flexWrap": "nowrap",
      "gap": "$spacing.4", "justifyContent": "flex-start", "alignItems": "stretch",
      "dimensions": {
        "width": "100%", "minWidth": "0", "maxWidth": "none",
        "height": "auto", "minHeight": "fit-content", "maxHeight": "none"
      },
      "background": { "type": "color", "color": "$roles.cardBg" },
      "border": {
        "borderType": "none", "radiusType": "all",
        "radius": { "all": "$radius.xs" },
        "border": { "all": { "color": "transparent", "style": "none", "width": "0px" } }
      },
      "shadow": { "offsetX": 0, "offsetY": 0, "blurRadius": 0, "spreadRadius": 0, "color": "transparent" },
      "stylingBox": { "padding": 0 }
    },
    "tablet": { "$inherit": "desktop" },
    "mobile": { "$inherit": "desktop" }
  },

  "header-band": {
    "componentType": "container",
    "desktop": {
      "display": "flex", "flexDirection": "column", "flexWrap": "nowrap",
      "gap": "$spacing.1", "justifyContent": "flex-start", "alignItems": "flex-start",
      "dimensions": {
        "width": "100%", "minWidth": "0", "maxWidth": "none",
        "height": "auto", "minHeight": "fit-content", "maxHeight": "none"
      },
      "background": { "type": "color", "color": "$roles.cardHeaderBg" },
      "border": {
        "borderType": "custom", "radiusType": "all",
        "radius": { "all": "$radius.xs" },
        "border": {
          "all": { "color": "transparent", "style": "none", "width": "0px" },
          "top": { "color": "transparent", "style": "none", "width": "0px" },
          "bottom": { "color": "$roles.hairline", "style": "solid", "width": "1px" },
          "left": { "color": "transparent", "style": "none", "width": "0px" },
          "right": { "color": "transparent", "style": "none", "width": "0px" }
        }
      },
      "shadow": { "offsetX": 0, "offsetY": 0, "blurRadius": 0, "spreadRadius": 0, "color": "transparent" },
      "stylingBox": {
        "paddingTop": "$spacing.6", "paddingBottom": "$spacing.6",
        "paddingLeft": "$spacing.6", "paddingRight": "$spacing.6"
      }
    },
    "tablet": {
      "$inherit": "desktop",
      "stylingBox": {
        "paddingTop": "$spacing.4", "paddingBottom": "$spacing.4",
        "paddingLeft": "$spacing.4", "paddingRight": "$spacing.4"
      }
    },
    "mobile": {
      "$inherit": "desktop",
      "stylingBox": {
        "paddingTop": "$spacing.3", "paddingBottom": "$spacing.3",
        "paddingLeft": "$spacing.3", "paddingRight": "$spacing.3"
      }
    }
  },

  "toolbar-row": {
    "componentType": "container",
