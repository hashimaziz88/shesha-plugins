{
  "screen": "Flight Details",
  "archetype": "record-detail",
  "theme": "requirements-studio",
  "viewport": "1440x900",
  "entity": {
    "fullClassName": "Boxfusion.Test.Domain.Flight",
    "modelType": { "name": "Flight", "module": "boxfusion.test" }
  },
  "form": { "module": "boxfusion.test", "name": "flight-details", "label": "Flight" },
  "nodes": [
    { "node": "dataContext", "type": "dataContext" },
    { "node": "page", "type": "container", "role": "page-root",
      "children": ["pageHeader", "validationErrors", "body"] },
    { "node": "pageHeader", "type": "container", "role": "header-band", "slot": "page",
      "children": ["heading", "subtitle", "lifecycleButtonGroup"] },
    { "node": "heading", "type": "text", "slot": "pageHeader", "content": "{{data.flightNumber}} · {{data.airline}}" },
    { "node": "subtitle", "type": "text", "slot": "pageHeader",
      "content": "{{data.originCity}} ({{data.originCode}}) → {{data.destinationCity}} ({{data.destinationCode}})" },
    { "node": "lifecycleButtonGroup", "type": "buttonGroup", "slot": "pageHeader",
      "items": [
        { "label": "Start Edit", "action": { "actionName": "Start Edit", "actionOwner": "shesha.form" } },
        { "label": "Save", "primary": true, "action": { "actionName": "Submit", "actionOwner": "shesha.form" } },
        { "label": "Cancel Edit", "action": { "actionName": "Cancel Edit", "actionOwner": "shesha.form" } }
      ] },
    { "node": "validationErrors", "type": "validationErrors", "slot": "page" },
    { "node": "body", "type": "container", "slot": "page",
      "style": { "desktop": { "display": "flex", "flexDirection": "row", "gap": 24, "dimensions": { "width": "100%" } } },
      "children": ["mainColumn", "detailRail"] },
    { "node": "mainColumn", "type": "container", "role": "section-card", "slot": "body",
      "style": { "desktop": { "dimensions": { "width": "calc(100% - 356px)" } } },
      "children": ["detailTabs"] },
    { "node": "detailTabs", "type": "tabs", "slot": "mainColumn",
      "tabs": [
        { "key": "service", "title": "Service", "children": ["rowService", "rowOrigin"] },
        { "key": "schedule", "title": "Schedule", "children": ["rowTimes"] }
      ] },
    { "node": "rowService", "type": "container", "role": "field-row", "slot": "detailTabs",
      "children": ["flightNumberWrap", "airlineWrap"] },
    { "node": "flightNumberWrap", "type": "container", "slot": "rowService",
      "style": {
        "desktop": { "dimensions": { "width": "calc(50% - 6px)" } },
        "tablet": { "dimensions": { "width": "calc(50% - 6px)" } },
        "mobile": { "dimensions": { "width": "100%" } }
      },
      "children": ["flightNumber"] },
    { "node": "flightNumber", "type": "textField", "slot": "flightNumberWrap", "content": "Flight Number" },
    { "node": "airlineWrap", "type": "container", "slot": "rowService",
      "style": {
        "desktop": { "dimensions": { "width": "calc(50% - 6px)" } },
        "tablet": { "dimensions": { "width": "calc(50% - 6px)" } },
        "mobile": { "dimensions": { "width": "100%" } }
      },
      "children": ["airline"] },
    { "node": "airline", "type": "textField", "slot": "airlineWrap", "content": "Airline" },
    { "node": "rowOrigin", "type": "container", "role": "field-row", "slot": "detailTabs",
      "children": ["originCodeWrap", "originCityWrap"] },
    { "node": "originCodeWrap", "type": "container", "slot": "rowOrigin",
      "style": {
        "desktop": { "dimensions": { "width": "calc(50% - 6px)" } },
        "tablet": { "dimensions": { "width": "calc(50% - 6px)" } },
        "mobile": { "dimensions": { "width": "100%" } }
      },
      "children": ["originCode"] },
    { "node": "originCode", "type": "textField", "slot": "originCodeWrap", "content": "Origin Code" },
    { "node": "originCityWrap", "type": "container", "slot": "rowOrigin",
      "style": {
        "desktop": { "dimensions": { "width": "calc(50% - 6px)" } },
        "tablet": { "dimensions": { "width": "calc(50% - 6px)" } },
        "mobile": { "dimensions": { "width": "100%" } }
      },
      "children": ["originCity"] },
    { "node": "originCity", "type": "textField", "slot": "originCityWrap", "content": "Origin City" },
    { "node": "rowTimes", "type": "container", "role": "field-row", "slot": "detailTabs",
      "children": ["departureTimeWrap", "arrivalTimeWrap"] },
    { "node": "departureTimeWrap", "type": "container", "slot": "rowTimes",
      "style": {
        "desktop": { "dimensions": { "width": "calc(50% - 6px)" } },
        "tablet": { "dimensions": { "width": "calc(50% - 6px)" } },
        "mobile": { "dimensions": { "width": "100%" } }
      },
      "children": ["departureTime"] },
    { "node": "departureTime", "type": "dateField", "slot": "departureTimeWrap", "content": "Departs" },
    { "node": "arrivalTimeWrap", "type": "container", "slot": "rowTimes",
      "style": {
        "desktop": { "dimensions": { "width": "calc(50% - 6px)" } },
        "tablet": { "dimensions": { "width": "calc(50% - 6px)" } },
        "mobile": { "dimensions": { "width": "100%" } }
      },
      "children": ["arrivalTime"] },
    { "node": "arrivalTime", "type": "dateField", "slot": "arrivalTimeWrap", "content": "Arrives" },
    { "node": "detailRail", "type": "container", "role": "detail-rail", "slot": "body",
      "children": ["railNote", "isActive"] },
    { "node": "railNote", "type": "text", "slot": "detailRail", "content": "Aircraft ready" },
    { "node": "isActive", "type": "checkbox", "slot": "detailRail", "content": "Aircraft ready" }
  ],
  "bindings": [],
  "assertions": [
    "tab(flightNumber, service)",
    "tab(originCode, service)",
    "tab(departureTime, schedule)"
  ],
  "dependencies": []
}
